{
  "name": "btc-dashboard",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --experimental-strip-types --no-warnings --import ./backtest/register.mjs --test \"__tests__/*.test.ts\"",
    "test:watch": "node --experimental-strip-types --no-warnings --import ./backtest/register.mjs --test --watch \"__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "backtest": "node --experimental-strip-types --no-warnings --import ./backtest/register.mjs backtest/run.ts",
    "backtest:fetch": "node --experimental-strip-types --no-warnings --import ./backtest/register.mjs backtest/fetch.ts",
    "backtest:sweep": "node --experimental-strip-types --no-warnings --import ./backtest/register.mjs backtest/run.ts --sweep",
    "backtest:split": "node --experimental-strip-types --no-warnings --import ./backtest/register.mjs backtest/run.ts --split",
    "eas-build-pre-install": "corepack enable && yarn install"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~54.0.9",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "packageManager": "yarn@4.13.0"
}
